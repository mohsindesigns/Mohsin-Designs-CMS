            "whatIncluded": {
              "eyebrow": "03 // WHAT'S INCLUDED",
              "titleIntro": "Web Development Solutions Built Around",
              "titleHighlight": "Your Actual Goals",
              "pillars": [
                {
                  "title": "Custom Web Design",
                  "desc": "Templates let you blend in. Custom design makes you special. We begin with your brand and your consumer. Our unique web design creates layouts, color and flow based on how people really navigate across a site. The outcome is obviously yours and every visitor is taken to the action that increases your company.",
                  "features": []

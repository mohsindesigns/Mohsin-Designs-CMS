              "pillars": [
                {
                  "title": "Google Business Profile Management Services",
                  "desc": "An inactive listing is falling behind its active rivals. We’ll take care of your Google Business Profile for you. We’ll add frequent updates, update your information, upload photos, and respond quickly to reviews. This is the type of activity that Google and consumers appreciate.",
                  "features": []

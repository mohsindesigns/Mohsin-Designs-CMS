            "whatIncluded": {
              "enabled": true,
              "eyebrow": "03 // WHAT'S INCLUDED",
              "titleIntro": "Every Design Service Your Brand Needs",
              "titleHighlight": "Under One Roof",
              "description": "From brand identity to packaging to social, our graphic design services are mapped to your industry, your audience, and your goals, not pulled off a shelf. Cookie cutter design is the fastest way to look like everyone else, so we start with your business before we open a single file. Here is what we bring to the table.",
              "pillars": [
                {
                  "title": "Brand Identity Design",
                  "desc": "Your identity is the system people remember long after the details fade. Our brand identity design services build the full kit, logo, palette, type, and clear rules, so your brand stays sharp whether it shows up on a billboard, an invoice, or a quick story.",
                  "features": []
                },
                {
                  "title": "Logo Design",
                  "desc": "A logo carries more weight than any other asset you own, so it cannot be an afterthought. Our logo design services give you a mark that is simple, scalable, and built to last, clean at thumbnail size and strong at full scale, with the source files included.",
                  "features": []
                },
                {
                  "title": "Packaging Design",
                  "desc": "Packaging is the only ad a customer truly touches, and it seals the deal right on the shelf. We create boxes, labels and wraps that leap off the shelf from competitors and communicate quality quickly so consumers believe they are purchasing something expensive before they ever open it.",
                  "features": []
                },
                {
                  "title": "Social Media Design",
                  "desc": "Feeds move fast, and they are not forgiving. We create scroll stopping post templates, carousels, and story graphics that hold a thumb mid swipe, and they pair perfectly with our social media management so your visuals and your posting plan finally move together.",
                  "features": []
                },
                {
                  "title": "Website Graphic Design",
                  "desc": "Visitors determine whether to remain or leave a site within seconds based on its graphics. We make banners, icons, and infographics that load clean and convert, work that fits nicely with our website development and UI/UX design so the whole experience seems planned, not put together.",
                  "features": []
                },
                {
                  "title": "Company Profile Design",
                  "desc": "In B2B, it is corporate profile that wins or loses the sale. We develop professional, effective profiles and pitch decks that arrange your narrative, show off your talents, and make prospects take you seriously long before the first meeting wraps up.",
                  "features": []
                },
                {
                  "title": "Marketing & Print Collateral",
                  "desc": "Every flyer, brochure, poster and business card is a little brand ambassador. We provide print and digital materials that are consistent with your brand and consistent with your content marketing so the appearance and the text reinforce each other.",
                  "features": []
                }
              ]
            },
            "strategy": {
              "enabled": true,
              "eyebrow": "04 // HOW IT WORKS",
              "titleIntro": "What Strong Design Really Does To",
              "titleHighlight": "Your Bottom Line",
              "description": "Strong graphic design services do three jobs at once: they make your brand easy to recognize, build quiet trust through consistency, and steer the eye toward action. The result is simple. The right people notice you, believe you, and choose you faster than they choose the next option.\n\nRecognition comes first, and most of it happens without thinking. The brain processes visuals significantly quicker than it does words, therefore a strong visual identity is remembered, a weak one is scrolling past. Trust comes next, and consistency is how you gain it. A brand that is the same everywhere seems secure. People purchase from brands that feel safe.",
              "components": [
                {
                  "num": "01",
                  "title": "Instant Recognition",
                  "desc": "A clear identity comes first. We build logos, color systems, and type that work together, so your brand is spotted at a glance and never mixed up with the competitor sitting right below you."
                },
                {
                  "num": "02",
                  "title": "Earned Trust",
                  "desc": "Next, we lock that look across every touchpoint. When your posts, brochures, and site graphics all speak the same visual language, your business reads as solid, organized, and worth a higher price."
                },
                {
                  "num": "03",
                  "title": "Guided Action",
                  "desc": "Last, we use spacing, contrast, and hierarchy to push attention toward the one thing that matters, the button, the offer, the call, so good looking design quietly works as conversion rate optimization too."
                }
              ]
            },

          "whatIncluded": {
            "enabled": true,
            "eyebrow": "03 // WHAT'S INCLUDED",
            "titleIntro": "Social Media Solutions Shaped Around",
            "titleHighlight": "Your Brand, Not A Template",
            "description": "Since every brand has a different selling strategy, our social media management services do not rely on generic sold-in-bulk calendars. Instead, we use a system that integrates paid social media, community management, and organic content to achieve your specific goals. Whether you are a scaling store or a new local business, our services are never templated.",
            "pillars": [
              {
                "title": "Social Media Strategy",
                "desc": "Time and money are wasted when posting is done without a plan. We create a defined strategy focused on your key goals and objectives. A defined frequency, mix, and choice of social media platforms and audience content themes are established to facilitate posting. Every post becomes goal oriented and exists to give you a measurable return.",
                "features": []
              },
              {
                "title": "Content Creation",
                "desc": "Weak content doesn’t stop anyone’s scroll. We create thumb-stopping, on-brand graphics, captions and short films that drive actual responses. We combine great graphic design with words that really convert, so your feed gets attention, saves and shares, instead of being buried in a busy timeline.",
                "features": []
              },
              {
                "title": "Post Scheduling",
                "desc": "Gaps in posting will negatively impact your reach. We've created one simple calendar, which means planned and timely posts, eliminating last minute posting and ensuring your social feed is active. Consistency wins on social media. Your social feed remains active during peak audience scroll times.",
                "features": []
              },
              {
                "title": "Community Management",
                "desc": "An unanswered comment might as well be a sales lead that was disregarded. We develop customer loyalty by responding to messages, comments, and mentions in a timely manner and in your brand voice. We turn casual scrollers into followers and loyal followers into repeat customers, and we do it all without asking.",
                "features": []
              },
              {
                "title": "Analytics & Reporting",
                "desc": "When it comes to guesswork, there is no place for it in your steady and lasting growth. We track reach, engagement, and conversions for each of your accounts, and we do it all with our easy-to-understand reports. Our reports are clear and concise, leaving no confusion about what is or isn’t working and what your next opportunity is.",
                "features": []
              },
              {
                "title": "Paid Social Advertising",
                "desc": "Even organic reach has its limits. We create social media ads with value added copy and design, highly focused target audiences, and offers that compel customers. With our social media advertising services, you don't need to worry about waste of ad dollars and effort. We put Meta Ads and campaigns in front of customers so that you can get more sales.",
                "features": []
              },
              {
                "title": "Social Media Audit",
                "desc": "Honestly, you can't see well enough to correct issues. We go deep into your accounts, content, posting patterns, and closest rivals to uncover missing reach, poor posts, and untapped perspectives; then provide you one clear, prioritized roadmap that lays out precisely how to expand your pages quicker from here.",
                "features": []
              }
            ]

            "whatIncluded": {
              "enabled": true,
              "eyebrow": "03 // WHAT'S INCLUDED",
              "titleIntro": "Every Type Of Logo We Craft,",
              "titleHighlight": "Shaped Around Your Brand",
              "description": "As no two brands are alike, we provide animation, redesign, 3D, mascots, and minimalist logos. A kids brand and a law firm wouldn’t use the same logo. Our custom logo design services are extensive, but the creative logo design services we provide are the most popular among our clients.",
              "pillars": [
                {
                  "title": "Logo Animation",
                  "desc": "Static art can be passed over, but motion draws attention. Our logo animation services include video intros, applications, reels, customized clips. Logo animation helps your firm look more current, distinctive and polished, and provides your customers more motivation to stop, gaze and remember your name.",
                  "features": []
                },
                {
                  "title": "Logo Redesign",
                  "desc": "Dated logos become unrecognizable, and unrecognizable logos lose customers. We provide redesign services which enhance the important and recognizable elements of a logo, while also updating the logo to a more modern design offering a professional look to the logo, and brand, while maintaining the company's reputation.",
                  "features": []
                },
                {
                  "title": "3D Logo Design",
                  "desc": "Creating depth in a logo is one of the ways to enhance a logo's overall value. To achieve purposeful depth with our 3D logo design, we create logos with visual depth which can be used in company product displays, presentations, and digital campaigns. We ensure that in regular, flat, and everyday use, the logo's design is also clean.",
                  "features": []
                },
                {
                  "title": "Company Logo Design",
                  "desc": "As your business grows, so should your logo. Our corporate logo design gives your brand a professional and attractive image on websites, business cards, proposals, stores and social media. A corporate logo design gives clients the impression that your organization is established, trustworthy and able to develop consistently.",
                  "features": []
                },
                {
                  "title": "Mascot Logo Design",
                  "desc": "A mascot logo design gives your brand a new identity and character. It’s a new identity, with a face, voice and personality your valued consumers can engage with. This design is ideal for family companies, sports teams, culinary brands, artists, and other firms looking to create an emotional connection with their consumers.",
                  "features": []
                },
                {
                  "title": "Minimalist Logo Design",
                  "desc": "Less is better. Our simple logo design process depends on your most crucial concept, removing irrelevant design elements. The outcome is a logo that’s clean and contemporary and will load fast across devices with a timeless style that resonates.",
                  "features": []
                },
                {
                  "title": "Wordmark & Monogram Logos",
                  "desc": "If your name is your logo, why not make it feel special? Our wordmark and monogram logos transform brand names or initials into signature logos that represent your brand in a clear and custom way at any size, giving businesses with strong names a mark that is instantly recognizable.",
                  "features": []
                }
              ]

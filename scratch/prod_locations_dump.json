          "whatIncluded": {
            "enabled": true,
            "eyebrow": "03 // WHAT'S INCLUDED",
            "titleIntro": "UI/UX Solutions Shaped Around",
            "titleHighlight": "How Your Users Behave",
            "description": "Because no two products have identical users, having a universal template is a losing game. Our UI/UX web design services adapt to your users and your field, and to the specific behavior you’d like your users to demonstrate, no matter if you’re a growing band or a small startup.",
            "pillars": [
              {
                "title": "User Research & Strategy",
                "desc": "Designing based on subjective perceptions leads to bad design. That is why we analyze your target audience and your potential market using interviews, data, and mapping to outline and identify pain points. Using this data ensures that every design decision made is based on the reality of your potential users.",
                "features": []
              },
              {
                "title": "Wireframing & Prototyping",
                "desc": "Before investing in visual design, we flesh the structure of the design. Our wireframes and prototypes help conduct early design usability testing, and help identify unexpected design flows and sticking points. It helps us stay within budget and materialize design concepts that are user research focused.",
                "features": []
              },
              {
                "title": "Website UI/UX Design",
                "desc": "Your website is often the first impression of your brand. Our ui/ux web design services center on professional website design that loads fast, and help create optimal layouts and website designs that help guide your visitors from landing to taking the desired action.",
                "features": []
              },
              {
                "title": "Mobile App UI/UX Design",
                "desc": "Our thumb friendly design services ensure that your app has features that retain users and create a positive user experience. Our web application ui ux design services combined with our app development services create a user friendly experience for even the most feature dense applications.",
                "features": []
              },
              {
                "title": "Usability Testing & Audit",
                "desc": "Invisible friction can't be fixed. Real-world users are placed in front of your system product to show where they hesitate, get confused and abandon a task. These come with a roadmap of improvements to help you retain and please users faster.",
                "features": []
              }
            ]
          },
          "strategy": {
            "enabled": true,
            "eyebrow": "04 // HOW IT WORKS",
            "titleIntro": "How Great Design Quietly Turns",
            "titleHighlight": "Clicks Into Customers",
            "description": "Picture every tap, scroll, and swipe a visitor makes inside your product. Each one is a tiny decision where they move forward or give up. Strong ui/ux design services shape those moments so the next step always feels obvious, removing friction where people usually drop off.\n\nImagine instead your website or app as a peaceful guide (not a puzzle). Smart interface design aligns your product with customer needs, establishes trust with neat visual hierarchy, and makes signing up, booking or buying straightforward. That clarity is where excellent design becomes income.\n\nTo make that happen, we focus on three core areas:",
            "components": [
              {
                "num": "01",
                "title": "Clarity First",
                "desc": "Every strong product starts with structure. We organize information architecture and navigation so users always know where they are, where to go next, and how to get what they came for."
              },
              {
                "num": "02",
                "title": "Trust Through Design",
                "desc": "Next, we build credibility with consistent visual systems, readable type, and accessible color, so your interface feels professional and safe to act on right away."
              },
              {
                "num": "03",
                "title": "Conversion By Intent",
                "desc": "Finally, we map every screen to real user intent, guiding people toward action while keeping them engaged long enough to become loyal, paying customers."
              }
            ]
          },
          "benefits": {
            "enabled": true,
            "eyebrow": "05 // WHY IT MATTERS",
            "titleIntro": "Why Good UI/UX Decides",
            "titleHighlight": "Your Long Term Growth",
            "description": "Design matters. Well crafted interfaces help ease the tension of using a product, therefore people trust the product, prefer it, and are more willing to spend their money on it.",
            "outcomeText": "",
            "list": [
              {
                "metric": "",
                "title": "Higher Conversion Rates",
                "desc": "Then there is activity when friction falls away. A streamlined interface boosts conversions because people locate what they want without thinking twice. Clear and purposeful design converts interested visitors into confident shoppers who convert.",
                "tag": "01",
                "iconName": "TrendingUp",
                "outcomeText": ""
              },
              {
                "metric": "",
                "title": "Stronger User Retention",
                "desc": "People go back to goods that value their time. Smooth flows, rapid loading and easy layouts develop habits, so consumers stay coming back, instead of wandering to a cleaner rival.",
                "tag": "02",
                "iconName": "Users",
                "outcomeText": ""
              },
              {
                "metric": "",
                "title": "Lower Support Costs",
                "desc": "A self-explanatory interface answers questions before they're asked. When users rarely get stuck, support tickets drop, onboarding speeds up, and your team spends less time fixing confusion.",
                "tag": "03",
                "iconName": "DollarSign",
                "outcomeText": ""
              },
              {
                "metric": "",
                "title": "Real Brand Loyalty",
                "desc": "A great experience becomes a feeling people attach to your brand. That trust is hard for rivals to copy, and it keeps customers choosing you long after the first visit.",
                "tag": "04",
                "iconName": "Heart",
                "outcomeText": ""
              }
            ]
          },
          "process": {
            "enabled": true,
            "eyebrow": "06 // OUR PROCESS",
            "titleIntro": "The Step By Step Process Behind",
            "titleHighlight": "Products People Love",
            "description": "Good design is never a lucky accident. We follow a clear, repeatable process that removes friction, sharpens clarity, and turns rough ideas into polished products people love using.",
            "calloutTag": "",
            "calloutText": "",
            "steps": [
              {
                "title": "Discovery & Research",
                "desc": "First, we dig into your users, goals, and competitors to find the real problems worth solving before any design begins.",
                "phaseTag": "STEP 01",
                "deliverables": [],
                "footerLeft": "",
                "footerRight": ""
              },

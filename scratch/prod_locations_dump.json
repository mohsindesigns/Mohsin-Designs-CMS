                {
                  "metric": "",
                  "title": "Premium Brand Perception",
                  "desc": "Looking expensive lets you charge like it. Cohesive visuals lift you above cheaper rivals and back up higher prices, because buyers assume a brand that invests in its look invests in its product too. Perception becomes real pricing power.",
                  "tag": "02",
                  "iconName": "Award",
                  "outcomeText": ""

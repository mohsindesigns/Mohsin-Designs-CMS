          "whatIncluded": {
            "enabled": true,
            "eyebrow": "03 // WHAT'S INCLUDED",
            "titleIntro": "Content Solutions Built Around",
            "titleHighlight": "Your Real Growth Goals",
            "description": "Since no two companies are quite the same, there isn’t a universal content plan that will be successful for everyone. We create a content plan that aligns with the unique aspects of your business, including your target customers, your desired business outcomes, and your sales.",
            "pillars": [
              {
                "title": "SEO Content Writing",
                "desc": "Search engines don't favor overly lengthy content. Our SEO content writing service combines keyword research with content that is responsive to search queries. We refine your existing or added titles, headings, internal links, and other on-page elements while improving your visibility on Google. That's how modern search engine optimization turns into steady, free traffic.",
                "features": []
              },
              {
                "title": "Conversion Copywriting",
                "desc": "Conversion copywriting traffic isn't useful if your site visitors don't convert. Our copywriting inspires action and removes the invisible barriers holding them back. Whether it is an email, homepage, or a product page, the copy encourages your visitors to take the action we want.",
                "features": []
              },
              {
                "title": "Blog Writing & Editorial Strategy",
                "desc": "Your business's blog should not include your personal views. It should provide content that meets the needs of readers. We create blog topics that are centered around the needs of your target customers and create a publication schedule that improves your site's authority. Each post is created to draw in readers without the need for a sales call.",
                "features": []
              },
              {
                "title": "Social Media Content Writing",
                "desc": "In the age of fast media your posts will vanish along with your audience. With our services, we give your social media channels a distinct voice and a constant flow of creative posts that will convert scrollers into community members. This service also pairs well with our active social media management service that allows you to transfer strategy and posting to us.",
                "features": []
              },
              {
                "title": "Brand Storytelling",
                "desc": "People remember stories. They don't remember features. We translate the story of your 'why' and your unique mission into a powerful message. We help you stay on-brand and make an impact wherever you go. Good brand content marketing makes your brand memorable, and your audience will never be able to compare your price to your value.",
                "features": []
              },
              {
                "title": "Website & Landing Page Copy",
                "desc": "Your most important pages deserve your sharpest words. We write website and landing page copy built to convert, with a clear hierarchy, a persuasive flow, and calls to action that get out of the way, so visitors grasp the offer and move. It works best beside thoughtful website development that gives the copy the speed and structure to perform.",
                "features": []
              }
            ]
          },

            "results": {
              "enabled": true,
              "eyebrow": "07 // PROVEN RESULTS",
              "titleIntro": "Local Results That Prove",
              "titleHighlight": "The Work Pays Off",
              "description": "Numbers speak louder than promises, and these results show what focused app development services can deliver when design, engineering, and testing pull in the same direction. Each project below started with a real business problem and ended with growth the owners could feel.",

            "whatIncluded": {
              "eyebrow": "WHAT'S INCLUDED",
              "titleIntro": "SEO Solutions Built Around Your Real ",
              "titleHighlight": "Business Growth Needs",
              "pillars": [
                {
                  "title": "Technical SEO",
                  "desc": "Rankings are often obstructed by hidden technical issues. We resolve errors related to crawling, loading, linking, and site structure to help search engines comprehend your web pages. A solid technical framework improves the speed at which your site is indexed and the ranking it achieves in an increasingly competitive organic search landscape.\n\n",
                  "features": []
                },
                {
                  "title": "On Page SEO",
                  "desc": "Each page on your website has the potential to be ranked. We enhance page titles, headings, and meta descriptions. We also improve the content and internal links of each page to ensure it is keyword focused. We help both search engines and potential site visitors understand your page and its offerings to improve engagement and rankings.\n\n",
                  "features": []
                },
                {
                  "title": "Off Page SEO",
                  "desc": "To obtain a strong ranking, your website must have trust signals from sources outside your website. We earn trust from outside sources by building backlinks, gaining relevant mentions and online authority, through ethical link building. When trusted websites point to your pages, your website is seen as credible, which helps you outperform your competitors.\n\n",
                  "features": []
                },
                {
                  "title": "SEO Audit",
                  "desc": "You can’t resolve issues you don’t know exist. Our SEO audit analyzes your entire website to clear up missing content, identify failing pages, and locate other lost keyword opportunities. The honest and accurate repair roadmap prioritizes your fixes to give your company growth that is strong, confident, and most importantly, profitable.\n\n",
                  "features": []
                },
                {
                  "title": "Local SEO",
                  "desc": "Your company needs to be the first choice when customers make a decision. Our Local SEO places your company in the map results, local listings and searches, all of which have the highest buying intent. We help your company by optimizing citations, reviews, and location pages so that more customers select your company.\n\n",
                  "features": []
                },

# Copy to .env.local and fill in. Never commit .env.local.

MONGODB_URI=
MONGODB_DB=

# First-run admin account (Admin > Users can change it afterwards)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Outbound e-mail: ONE SMTP transport for every site form (/api/send) and admin password resets.
# Brevo: Settings > SMTP & API. If "Authorized IPs" is enabled there, add your server's IP or
# the relay answers "525 5.7.1 Unauthorized IP address".
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a sender verified in Brevo
MAIL_FROM="Mohsin Designs <you@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=hello@mohsindesigns.com

# Mohsin Designs CRM Lead Form Integration
LEAD_FORM_API_URL=https://app.mohsindesigns.com/api/public/lead-forms/otXOxJkQULota1Ghk8Fh8ZQgGfFcmu4o/submit

NEXT_PUBLIC_BASE_URL=https://mohsindesigns.com
CLOUDINARY_URL=

# Optional: Cloudflare Turnstile. Without these the always-pass test keys are used (no real captcha).
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Optional: AI chat widget. Get a key at https://console.anthropic.com/settings/keys - without
# it the widget simply doesn't render (see GET /api/chat), nothing else is affected.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
